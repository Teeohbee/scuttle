# Godot 4+ specific ignores
.godot/
/android/
.DS_Store

# The global macOS "Icon?" rule also matches directories named "icons"
!src/crew/icons/

# Bot playtest output
/_playtest/results/

# Addons are installed by gd-plug (see plug.gd), only gd-plug itself is tracked
.plugged/
addons/*
!addons/gd-plug/

# gdUnit4 test reports
/reports/
